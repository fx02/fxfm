{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fxfm",
  "version": "0.1.28",
  "identifier": "hr.pvt.fxfm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "fxfm",
        "width": 1300,
        "height": 820,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: asset: http://asset.localhost; frame-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": [], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Total-Commander-style file manager",
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["libsecret-tools", "libasound2 | libasound2t64"],
        "recommends": ["gvfs-backends", "smbclient", "avahi-utils", "fontconfig"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    }
  }
}
