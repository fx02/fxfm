# syntax=docker/dockerfile:1
# amd64 packages built on an arm64 host (scripts/build-linux.sh amd64): emulated x86 rustc
# crashes under QEMU, so this arm64 Ubuntu 22.04 cross-compiles to x86_64 with Ubuntu's
# multiarch amd64 libraries (WebKitGTK 4.1 & co.) and the x86-64 GNU linker (glibc 2.35, as
# the arm64 package: Ubuntu 22.04+, Pop!_OS 22.04+, Linux Mint 21+, Debian 12+).
# The secret `ca` (the Mac's trusted certificates) is used only while downloading.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
# arm64 packages come from ports.ubuntu.com, amd64 ones from archive/security.ubuntu.com.
RUN sed -i 's/^deb /deb [arch=arm64] /' /etc/apt/sources.list \
    && printf '%s\n' \
      "deb [arch=amd64] http://archive.ubuntu.com/ubuntu jammy main restricted universe" \
      "deb [arch=amd64] http://archive.ubuntu.com/ubuntu jammy-updates main restricted universe" \
      "deb [arch=amd64] http://security.ubuntu.com/ubuntu jammy-security main restricted universe" \
      > /etc/apt/sources.list.d/amd64.list
# The WebKitGTK, JavaScriptCore and libsoup -dev packages depend on gobject-introspection:amd64
# (and libsoup on sysprof's capture library), which cannot be installed beside the arm64
# Python; their headers and .pc files are unpacked instead (dpkg -x), on top of the amd64
# runtime libraries and the -dev packages they need.
RUN dpkg --add-architecture amd64 && apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates file pkg-config \
      gcc-x86-64-linux-gnu g++-x86-64-linux-gnu libc6-dev-amd64-cross \
      libgtk-3-dev:amd64 librsvg2-dev:amd64 libglib2.0-dev:amd64 \
      libwebkit2gtk-4.1-0:amd64 libjavascriptcoregtk-4.1-0:amd64 libsoup-3.0-0:amd64 \
      libpsl-dev:amd64 libsqlite3-dev:amd64 libnghttp2-dev:amd64 libbrotli-dev:amd64 zlib1g-dev:amd64 \
      libayatana-appindicator3-dev:amd64 libssl-dev:amd64 libasound2-dev:amd64 \
      libdbus-1-dev:amd64 libxdo-dev:amd64 \
    && cd /tmp && apt-get download libwebkit2gtk-4.1-dev:amd64 libjavascriptcoregtk-4.1-dev:amd64 \
         libsoup-3.0-dev:amd64 libsysprof-4-dev:amd64 \
    && for d in /tmp/*.deb; do dpkg -x "$d" /; done && rm /tmp/*.deb \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
ARG RUST_VERSION
RUN --mount=type=secret,id=ca \
    curl -sSf --retry 5 --retry-all-errors --cacert /run/secrets/ca -o /tmp/rustup.sh https://sh.rustup.rs \
    && SSL_CERT_FILE=/run/secrets/ca RUSTUP_USE_CURL=1 sh /tmp/rustup.sh -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup.sh \
    && SSL_CERT_FILE=/run/secrets/ca rustup target add x86_64-unknown-linux-gnu \
    && SSL_CERT_FILE=/run/secrets/ca rustup component add rustfmt clippy
RUN --mount=type=secret,id=ca CARGO_HTTP_CAINFO=/run/secrets/ca cargo install tauri-cli --version "^2" --locked
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH_x86_64_unknown_linux_gnu=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
    PKG_CONFIG_LIBDIR_x86_64_unknown_linux_gnu=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
WORKDIR /src
